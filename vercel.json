{
  "redirects": [
    { "source": "/", "destination": "/library.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/hebrew-mcp" },
    { "source": "/mcp/:path*", "destination": "/api/hebrew-mcp" },
    { "source": "/api/hebrew-episode-share", "destination": "/api/hebrew-mcp?episode_share=1" },
    { "source": "/listen/:token/:slug", "destination": "/api/hebrew-mcp?episode_page=1&share=:token" },
    { "source": "/listen/:token", "destination": "/api/hebrew-mcp?episode_page=1&share=:token" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/episode.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/episode.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
